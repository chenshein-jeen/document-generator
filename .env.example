# --- MinIO (the only storage backend) ---
# MINIO_ENDPOINT must be a bare host[:port] (no scheme) — MINIO_SECURE
# controls http vs https.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

BUCKET=documents
TEMPLATES_PREFIX=templates/
GENERATED_PREFIX=generated/
PRESIGNED_URL_EXPIRY=3600

# Object key of the template /generate falls back to when a request omits
# template_id (set after seeding a template via POST /templates/upload).
DEFAULT_TEMPLATE_ID=
